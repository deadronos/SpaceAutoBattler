#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Skip hooks when running in CI or when HUSKY=0 is set
if [ "$HUSKY" = "0" ] || [ "$CI" = "true" ]; then
	echo "[husky] Skipping pre-commit hook (HUSKY=$HUSKY, CI=$CI)"
	exit 0
fi

# Run lint-staged using the locally installed devDependency.
# --no-install fails fast if not installed, avoiding network fetches.
npx --no-install lint-staged
