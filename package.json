{
  "name": "space-autobattler",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/deadronos/SpaceAutoBattler.git"
  },
  "scripts": {
    "lint-staged": "vp staged",
    "test": "vp test",
    "test:ci": "vp test run && vp run perf:ai-budget",
    "dev": "vp dev",
    "start": "vp dev",
    "preview": "vp preview",
    "serve": "vp preview",
    "serve:e2e": "node ./scripts/e2e-static-server.mjs --port 8080",
    "prebuild": "node ./scripts/check-no-sync-reads.mjs",
    "build": "vp build",
    "build:dev": "vp build --mode development",
    "check-no-sync-reads": "node ./scripts/check-no-sync-reads.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:playwright": "playwright test -c playwright.config.cjs",
    "test:playwright:ship": "playwright test -c playwright.config.cjs ship-hulls.spec.ts",
    "generate-baselines": "vp build && vp run serve & sleep 5 && tsx scripts/generate-playwright-baselines.ts && node scripts/generate-star-baselines.mjs && kill %1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt . --write",
    "perf:ai-budget": "tsx ./scripts/perf/assert-ai-budget.ts",
    "bench:projectiles": "node scripts/bench/projectile-stress.mjs",
    "build:deploy": "vp run typecheck && vp test && vp build && cp dist/spaceautobattler.html dist/index.html",
    "prepare": "node -e \"if (!process.env.CI) try { require('child_process').execSync('vp config', { stdio: 'inherit' }); } catch {}\""
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "linux",
        "darwin"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    },
    "overrides": {
      "three": "$three",
      "vite": "npm:@voidzero-dev/vite-plus-core@~1.1.0",
      "@voidzero-dev/vite-plus-core": "~1.1.0",
      "brace-expansion": "^5.0.12",
      "nanoid": "^3.3.18",
      "source-map-js": "^1.2.2",
      "yaml": "^2.8.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "@voidzero-dev/*",
      "@rolldown/*",
      "@oxfmt/*",
      "@oxlint/*",
      "@oxlint-tsgolint/*",
      "vite-plus"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@playwright/test": "^1.64.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/babel-types": "7.0.16",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "jiti": "^2.7.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "pyright": "^1.1.414",
    "react-test-renderer": "^19.3.0",
    "rollup": "^4.64.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@~1.1.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plus": "1.1.0",
    "vitest": "^5.0.1",
    "yaml": "^2.8.3"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "glob": "^13.0.6",
    "gsap": "^3.15.0",
    "idb-keyval": "^6.3.0",
    "lodash": "^4.18.1",
    "lru-cache": "^11.5.3",
    "miniplex": "^2.0.0",
    "playwright-core": "^1.64.0",
    "postprocessing": "^6.39.5",
    "r3f-perf": "^7.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.0.15"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
