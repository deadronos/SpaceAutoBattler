{
  "name": "space-autobattler",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/deadronos/SpaceAutoBattler.git"
  },
  "scripts": {
    "lint-staged": "lint-staged",
    "test": "vitest --environment happy-dom",
    "test:ci": "vitest run --environment happy-dom && pnpm run perf:ai-budget",
    "dev": "vite --port 8080 --strictPort",
    "start": "vite --port 8080 --strictPort",
    "preview": "vite preview --port 8080 --strictPort",
    "serve": "vite preview --port 8080 --strictPort",
    "serve:e2e": "node ./scripts/e2e-static-server.mjs --port 8080",
    "prebuild": "pnpm run check-no-sync-reads",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "check-no-sync-reads": "node ./scripts/check-no-sync-reads.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:playwright": "playwright test -c playwright.config.cjs",
    "test:playwright:ship": "playwright test -c playwright.config.cjs ship-hulls.spec.ts",
    "generate-baselines": "pnpm run build && pnpm run serve & sleep 5 && tsx scripts/generate-playwright-baselines.ts && node scripts/generate-star-baselines.mjs && kill %1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,js}\" --ext .ts --ext .js",
    "lint:fix": "eslint \"src/**/*.{ts,js}\" --ext .ts --ext .js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,css,md}\"",
    "test:browser": "vitest --config=vitest.browser.config.ts",
    "perf:ai-budget": "tsx ./scripts/perf/assert-ai-budget.ts",
    "bench:projectiles": "node scripts/bench/projectile-stress.mjs",
    "build:deploy": "pnpm run typecheck && pnpm test && pnpm run build && cp dist/spaceautobattler.html dist/index.html"
  },
  "pnpm": {
    "overrides": {
      "three": "$three"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.0.1",
    "@eslint/markdown": "^7.5.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel-types": "7.0.16",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.4.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "c8": "^11.0.0",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.3",
    "jiti": "^2.6.1",
    "lint-staged": "^16.3.2",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "pyright": "^1.1.408",
    "react-test-renderer": "^19.2.4",
    "rollup": "^4.59.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "**/*.{ts,js,json,css,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "glob": "^13.0.6",
    "gsap": "^3.14.2",
    "idb-keyval": "^6.2.2",
    "lodash": "^4.17.23",
    "lru-cache": "^11.2.6",
    "miniplex": "^2.0.0",
    "playwright-core": "^1.58.2",
    "postprocessing": "^6.38.3",
    "r3f-perf": "^7.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.1.3",
    "three": "^0.183.2",
    "three-mesh-bvh": "^0.9.9",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.0.12"
  },
  "packageManager": "pnpm@10.31.0"
}
