{
  "name": "space-autobattler",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/deadronos/SpaceAutoBattler.git"
  },
  "scripts": {
    "lint-staged": "vp staged",
    "test": "vp test",
    "test:ci": "vp test run && vp run perf:ai-budget",
    "dev": "vp dev",
    "start": "vp dev",
    "preview": "vp preview",
    "serve": "vp preview",
    "serve:e2e": "node ./scripts/e2e-static-server.mjs --port 8080",
    "prebuild": "vp run check-no-sync-reads",
    "build": "vp build",
    "build:dev": "vp build --mode development",
    "check-no-sync-reads": "node ./scripts/check-no-sync-reads.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:playwright": "playwright test -c playwright.config.cjs",
    "test:playwright:ship": "playwright test -c playwright.config.cjs ship-hulls.spec.ts",
    "generate-baselines": "vp build && vp run serve & sleep 5 && tsx scripts/generate-playwright-baselines.ts && node scripts/generate-star-baselines.mjs && kill %1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt . --write",
    "perf:ai-budget": "tsx ./scripts/perf/assert-ai-budget.ts",
    "bench:projectiles": "node scripts/bench/projectile-stress.mjs",
    "build:deploy": "vp run typecheck && vp test && vp build && cp dist/spaceautobattler.html dist/index.html",
    "prepare": "vp config"
  },
  "pnpm": {
    "overrides": {
      "three": "$three",
      "vite": "npm:@voidzero-dev/vite-plus-core@~0.2.4",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
      "@voidzero-dev/vite-plus-core": "~0.2.4"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "@voidzero-dev/vite-plus-test": "patches/@voidzero-dev__vite-plus-test.patch"
    }
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.2",
    "@playwright/test": "^1.62.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel-types": "7.0.16",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.1",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "jiti": "^2.7.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.0",
    "pngjs": "^7.0.0",
    "pyright": "^1.1.411",
    "react-test-renderer": "^19.2.8",
    "rollup": "^4.62.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@~0.2.6",
    "vite-plugin-compression": "^0.5.1",
    "vite-plus": "0.2.6",
    "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.24"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "glob": "^13.0.6",
    "gsap": "^3.15.0",
    "idb-keyval": "^6.3.0",
    "lodash": "^4.18.1",
    "lru-cache": "^11.5.2",
    "miniplex": "^2.0.0",
    "playwright-core": "^1.62.0",
    "postprocessing": "^6.39.4",
    "r3f-perf": "^7.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.13",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.0.14"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
