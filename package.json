{
  "name": "space-autobattler",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint-staged": "lint-staged",
    "test": "vitest --environment happy-dom",
    "serve": "http-server ./dist -c-1 -p 8080",
    "serve:root": "http-server . -c-1 -p 8080",
    "prebuild": "npm run check-no-sync-reads",
    "build": "webpack --mode production",
    "build:webpack": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "start": "webpack serve --open --mode development",
    "check-no-sync-reads": "node ./scripts/check-no-sync-reads.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:playwright": "playwright test -c playwright.config.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,js}\" --ext .ts --ext .js",
    "lint:fix": "eslint \"src/**/*.{ts,js}\" --ext .ts --ext .js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,css,md}\"",
    "prepare": "husky install",
    "hash-assets": "node ./scripts/hash-assets.cjs",
    "validate-config": "node ./scripts/validate-config.mjs",
    "generate-memory-index": "node ./scripts/generate_memory_index.mjs",
    "add-memory-node": "node ./scripts/add_memory_node.mjs",
    "generate-memories": "node ./scripts/generate_memories.mjs",
    "test:browser": "vitest --config=vitest.browser.config.ts"
  },
  "devDependencies": {
    "@babel/preset-env": "latest",
    "@eslint/css": "*",
    "@eslint/js": "*",
    "@eslint/json": "*",
    "@eslint/markdown": "*",
    "@playwright/test": "*",
    "@types/bun": "latest",
    "@types/node": "^24.3.1",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.179.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "*",
    "c8": "^10.1.3",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "7.1.2",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.27.5",
    "globals": "^16.3.0",
    "happy-dom": "*",
    "html-webpack-plugin": "^5.5.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jiti": "^2.5.1",
    "lint-staged": "^16.1.5",
    "mini-css-extract-plugin": "^2.7.5",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "three": "*",
    "ts-loader": "^9.4.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4",
    "viz": "*",
    "webpack": "*",
    "webpack-bundle-analyzer": "*",
    "webpack-cli": "*",
    "webpack-dev-server": "*"
  },
  "lint-staged": {
    "**/*.{ts,js,json,css,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.18.2",
    "glob": "*",
    "gsap": "^3.13.0",
    "idb-keyval": "^6.2.1",
    "lodash": "^4.17.21",
    "lru-cache": "^11.1.0",
    "miniplex": "^1.0.0",
    "pixi.js": "^8.12.0",
    "playwright": "*",
    "postprocessing": "6.37.7",
    "puppeteer": "^24.19.0",
    "pyright": "^1.1.404",
    "rimraf": "*",
    "three-mesh-bvh": "^0.9.1",
    "three-stdlib": "^2.36.0",
    "vite": "^7.1.5",
    "zustand": "^4.5.7"
  }
}
