{
  "name": "space-autobattler",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint-staged": "lint-staged",
    "test": "vitest --environment happy-dom",
    "serve": "http-server ./dist -c-1 -p 8080",
    "serve:root": "http-server . -c-1 -p 8080",
    "prebuild": "npm run check-no-sync-reads",
    "build": "webpack --mode production",
    "build:webpack": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "start": "webpack serve --open --mode development",
    "check-no-sync-reads": "node ./scripts/check-no-sync-reads.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:playwright": "playwright test -c playwright.config.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,js}\" --ext .ts --ext .js",
    "lint:fix": "eslint \"src/**/*.{ts,js}\" --ext .ts --ext .js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,css,md}\"",
    "hash-assets": "node ./scripts/hash-assets.cjs",
    "validate-config": "node ./scripts/validate-config.mjs",
    "generate-memory-index": "node ./scripts/generate_memory_index.mjs",
    "add-memory-node": "node ./scripts/add_memory_node.mjs",
    "generate-memories": "node ./scripts/generate_memories.mjs",
    "test:browser": "vitest --config=vitest.browser.config.ts",
    "perf:baseline": "node ./scripts/perf/collect-baseline.mjs",
    "perf:instancer": "node ./scripts/perf/ship-instancer-harness.mjs",
    "perf:ai-budget": "tsx ./scripts/perf/assert-ai-budget.ts"
  },
  "devDependencies": {
    "@babel/preset-env": "latest",
    "@eslint/css": "*",
    "@eslint/js": "*",
    "@eslint/json": "*",
    "@eslint/markdown": "*",
    "@playwright/test": "*",
    "@types/bun": "latest",
    "@types/node": "^24.5.2",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "latest",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "*",
    "c8": "^10.1.3",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "latest",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.4.0",
    "happy-dom": "*",
    "html-webpack-plugin": "^5.6.4",
    "http-server": "^14.1.1",
    "jiti": "^2.5.1",
    "lint-staged": "^16.1.6",
    "mini-css-extract-plugin": "^2.9.4",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
  "prettier": "^3.6.2",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4",
  "react-test-renderer": "^19.1.1",
  "@testing-library/react": "^16.0.0",
    "webpack": "*",
    "webpack-bundle-analyzer": "*",
    "webpack-cli": "*",
    "webpack-dev-server": "*"
  },
  "lint-staged": {
    "**/*.{ts,js,json,css,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "latest",
    "@react-three/fiber": "^9.3.0",
    "@react-three/drei": "^10.7.6",
    "glob": "*",
    "gsap": "^3.13.0",
    "idb-keyval": "^6.2.2",
    "lodash": "^4.17.21",
    "lru-cache": "latest",
    "miniplex": "latest",
    "pixi.js": "latest",
    "playwright": "*",
    "postprocessing": "latest",
    "puppeteer": "latest",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "pyright": "^1.1.405",
    "rimraf": "*",
    "three": "latest",
    "three-mesh-bvh": "latest",
    "three-stdlib": "latest",
    "vite": "latest",
    "zustand": "latest"
  }
}
