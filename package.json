{
  "name": "space-autobattler",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint-staged": "lint-staged",
    "test": "vitest --environment happy-dom",
    "test:ci": "vitest run --environment happy-dom && npm run perf:ai-budget",
    "serve": "http-server ./dist -c-1 -p 8080",
    "serve:root": "http-server . -c-1 -p 8080",
    "prebuild": "npm run check-no-sync-reads",
    "build": "webpack --mode production",
    "build:webpack": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "start": "webpack serve --open --mode development",
    "check-no-sync-reads": "node ./scripts/check-no-sync-reads.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:playwright": "playwright test -c playwright.config.cjs",
    "test:playwright:ship": "playwright test -c playwright.config.cjs ship-hulls.spec.ts",
    "generate-baselines": "npm run build && npm run serve & sleep 5 && tsx scripts/generate-playwright-baselines.ts && node scripts/generate-star-baselines.mjs && kill %1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,js}\" --ext .ts --ext .js",
    "lint:fix": "eslint \"src/**/*.{ts,js}\" --ext .ts --ext .js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,css,md}\"",
    "test:browser": "vitest --config=vitest.browser.config.ts",
    "perf:ai-budget": "tsx ./scripts/perf/assert-ai-budget.ts",
    "bench:projectiles": "node scripts/bench/projectile-stress.mjs",
    "build:deploy": "npm run typecheck && npm test && npm run build && cp dist/spaceautobattler.html dist/index.html"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@eslint/css": "^0.13.0",
    "@eslint/js": "^9.38.0",
    "@eslint/json": "^0.13.2",
    "@eslint/markdown": "^7.5.0",
    "@playwright/test": "^1.55.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/babel-types": "7.0.16",
    "@types/bun": "^1.3.1",
    "@types/node": "^24.5.2",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitest/browser": "^4.0.3",
    "@vitest/coverage-v8": "^4.0.3",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "c8": "^10.1.3",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^7.2.13",
    "globals": "^16.4.0",
    "happy-dom": "^20.0.8",
    "html-webpack-plugin": "^5.6.4",
    "http-server": "^14.1.1",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.6",
    "mini-css-extract-plugin": "^2.9.4",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "react-compiler-webpack": "^0.2.1",
    "react-test-renderer": "^19.2.0",
    "rollup": "^4.52.3",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.3",
    "webpack": "^5.101.3",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "lint-staged": {
    "**/*.{ts,js,json,css,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "glob": "^11.0.3",
    "gsap": "^3.13.0",
    "idb-keyval": "^6.2.2",
    "lodash": "^4.17.21",
    "lru-cache": "^11.2.2",
    "miniplex": "^2.0.0",
    "playwright": "^1.55.1",
    "postprocessing": "^6.37.8",
    "pyright": "^1.1.407",
    "r3f-perf": "^7.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rimraf": "^6.0.1",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.1",
    "three-stdlib": "^2.36.0",
    "vite": "^7.1.12",
    "zustand": "^5.0.8"
  },
  "overrides": {
    "@react-three/drei": "^10.7.6"
  }
}
