{
  "compilerOptions": {
    "target": "esnext",
    "module": "Node16",
    "moduleResolution": "node16",
    "strict": true,
    "outDir": "dist/config",
    "downlevelIteration": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals", "react", "react/jsx-runtime"],
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "test/**/*.js",
    "scripts/**/*.mjs",
    "eslint.config.ts",
    "vitest.config.js"
  ],
  "exclude": ["node_modules", "dist", "test/vitest_old"]
}
